# HTTP server (Compose overrides HOST/PORT/database/web paths inside the container)
HOST=127.0.0.1
PORT=7694
TRUST_PROXY=false
LOG_LEVEL=info

# Storage
DATABASE_PATH=./data/ai_usage.db
WEB_ROOT=./web/dist
# Host database directory mounted at /data in Docker. Can live outside the clone,
# e.g. /srv/ai-usage/data. Includes the database, WAL/SHM, and exported snapshots.
AI_USAGE_DATA_HOST=./data

# Refresh policy (seconds unless noted)
MIN_INTERVAL_SEC=600
MAX_INTERVAL_SEC=21600
CHANGE_EPSILON_PP=0.5
RESET_SHIFT_SEC=120
RESET_GRACE_SEC=60
MANUAL_COOLDOWN_SEC=60
ERROR_MIN_SEC=300
ERROR_MAX_SEC=3600
CONCURRENCY=4
REQUEST_TIMEOUT_MS=15000

# Local execution uses the standard ~/.config/opencode, ~/.local/share/opencode,
# and ~/.codex locations. Compose sets the corresponding paths in the container.
# OPENCODE_CONFIG_DIR=/path/to/opencode/config
# CODEX_HOME=/path/to/codex

# Google Antigravity OAuth client configuration (CLIENT_SECRET in check_usage).
# Set this in your private .env when collecting Google accounts.
ANTIGRAVITY_CLIENT_SECRET=

# Codex token refresh: rotated tokens are written back to auth.json, so the
# Codex directory must be mounted writable.
CODEX_REFRESH=true
# CODEX_CLIENT_ID=
# CODEX_REFRESH_SKEW_SEC=300

# Optional explicit overrides
# ANTIGRAVITY_ACCOUNTS_PATH=/path/to/antigravity-accounts.json
# OPENCODE_GO_CONFIG_PATH=/path/to/opencode-go.json
# ONEPROVIDER_CONFIG_PATH=/path/to/oneprovider.json
# OPENCODE_AUTH_PATH=/path/to/opencode/auth.json
# VNAI_PRO_AUTH_PATH=/path/to/vnai-pro-auth.json
# CODEX_AUTH_PATH=/path/to/auth.json
INCLUDE_DISABLED=false

# Docker Compose host mounts
# Use absolute paths to existing credentials, or populate these local directories.
OPENCODE_CONFIG_HOST=./secrets/opencode
OPENCODE_DATA_HOST=./secrets/opencode-data
CODEX_HOME_HOST=./secrets/codex
# Set these to the host user's `id -u` and `id -g` values.
AI_USAGE_UID=1000
AI_USAGE_GID=1000

# Optional outbound proxy (also honors HTTP_PROXY / HTTPS_PROXY)
# MY_PROXY_URL=http://proxy.example:8080
