{
  "manifest_version": 3,
  "name": "AI Usage Companion",
  "version": "0.1.1",
  "description": "Watches the ai-usage dashboard and reconnects expired Mistral sessions by pushing fresh session cookies.",
  "permissions": ["cookies", "alarms", "notifications", "storage"],
  "host_permissions": ["https://chat.mistral.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "AI Usage",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-usage-companion@christian-f-brinkmann.de",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
